# Supabase Free Plan Configuration (Required for live PostgreSQL & Auth)
# Create a free project at https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# =============================================================================
# SERVER-SIDE ONLY INTEGRATIONS (Keep disabled; NEVER prefix secrets with VITE_)
# =============================================================================
# Notification Providers (Remain disabled until configured & explicitly enabled)
NOTIFICATIONS_PROVIDERS_ENABLED="false"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID="FreeRentTours"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Phase 2 Online Payment Gateway (Prepared architecture; DO NOT activate yet)
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_SECRET_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

